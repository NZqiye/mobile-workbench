<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_anniversary_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="临近的日子" android:textSize="14sp" android:textStyle="bold" android:textColor="#284A42" android:maxLines="1" />
        <TextView android:id="@+id/widget_position" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#526C63" android:maxLines="1" />
        <ImageView android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp" android:padding="15dp" android:src="@drawable/widget_next_light" android:tint="#456B61" android:contentDescription="下一个纪念日" android:visibility="gone" />
        <ImageView android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="48dp" android:padding="15dp" android:src="@drawable/widget_settings_light" android:tint="#456B61" android:contentDescription="选择展示的纪念日" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_upcoming_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_icon" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="10dp" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="纪念日" android:textSize="14sp" android:textStyle="bold" android:textColor="#243E39" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="10sp" android:textColor="#596A64" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/widget_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="—" android:textSize="22sp" android:textStyle="bold" android:textColor="#AD3655" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_upcoming_row_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_upcoming_icon_2" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="12dp" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_upcoming_title_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#243E39" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_upcoming_date_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="10sp" android:textColor="#596A64" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/widget_upcoming_days_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textSize="20sp" android:textStyle="bold" android:textColor="#AD3655" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_upcoming_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_upcoming_icon_3" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="12dp" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_upcoming_title_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#243E39" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_upcoming_date_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="10sp" android:textColor="#596A64" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/widget_upcoming_days_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textSize="20sp" android:textStyle="bold" android:textColor="#AD3655" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_upcoming_row_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_upcoming_icon_4" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="12dp" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_upcoming_title_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#243E39" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_upcoming_date_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="10sp" android:textColor="#596A64" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/widget_upcoming_days_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textSize="20sp" android:textStyle="bold" android:textColor="#AD3655" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_upcoming_row_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_upcoming_icon_5" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="12dp" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_upcoming_title_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="#243E39" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_upcoming_date_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="10sp" android:textColor="#596A64" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/widget_upcoming_days_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textSize="20sp" android:textStyle="bold" android:textColor="#AD3655" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="重要的日子，值得认真期待。" android:textSize="11sp" android:lineSpacingExtra="2dp" android:textColor="#456B61" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
