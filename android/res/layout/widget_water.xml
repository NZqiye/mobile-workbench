<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_water_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:gravity="center_vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="20dp" android:text="喝水进度" android:textColor="#1D4F60" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" />
        <TextView android:gravity="end|center_vertical" android:id="@+id/widget_percent" android:layout_width="44dp" android:layout_height="20dp" android:layout_marginStart="6dp" android:text="0%" android:textColor="#376473" android:textSize="12sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:layout_marginBottom="10dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
            <TextView android:id="@+id/widget_amount" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom" android:text="0" android:textColor="#164D61" android:textSize="38sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="38sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" />
            <TextView android:gravity="center_vertical" android:id="@+id/widget_goal" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="3dp" android:text="/ 2000 ml" android:textColor="#376473" android:textSize="13sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_icon" android:layout_width="64dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:scaleType="fitCenter" android:contentDescription="饮水水位" />
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:progressDrawable="@drawable/widget_water_progress" android:indeterminate="false" />
    <TextView android:gravity="center_vertical" android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="8dp" android:text="还差 2000 ml" android:textColor="#376473" android:textSize="12sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:includeFontPadding="false" />
</LinearLayout>
