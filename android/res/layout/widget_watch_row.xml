<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp">
    <FrameLayout android:layout_width="42dp" android:layout_height="63dp">
        <ImageView android:id="@+id/widget_row_poster" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="影视海报" android:visibility="gone" />
        <TextView android:id="@+id/widget_row_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/widget_poster_placeholder" android:text="剧" android:textColor="#5B6174" android:textSize="20sp" android:textStyle="bold" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/widget_row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#232A3B" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_row_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#5B6174" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/widget_row_countdown" android:layout_width="54dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:gravity="end" android:textColor="#975B13" android:textSize="17sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
</LinearLayout>
