<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_plan_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="今日待办" android:textColor="#F4F7F5" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B2C9C0" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_amount" android:layout_width="52dp" android:layout_height="42dp" android:gravity="center_vertical" android:textColor="#D3F4E1" android:textSize="34sp" android:textStyle="bold" android:fontFamily="sans-serif-light" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/widget_task_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="27dp" android:padding="6dp" android:gravity="center_vertical" android:background="@drawable/widget_plan_inset" android:textColor="#F4F7F5" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:drawableStart="@drawable/widget_check" android:drawablePadding="6dp" />
            <TextView android:id="@+id/widget_task_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="27dp" android:padding="6dp" android:gravity="center_vertical" android:background="@drawable/widget_plan_inset" android:layout_marginTop="4dp" android:textColor="#F4F7F5" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:drawableStart="@drawable/widget_check" android:drawablePadding="6dp" />
            <TextView android:id="@+id/widget_task_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="27dp" android:padding="6dp" android:gravity="center_vertical" android:background="@drawable/widget_plan_inset" android:layout_marginTop="4dp" android:visibility="gone" android:textColor="#F4F7F5" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:drawableStart="@drawable/widget_check" android:drawablePadding="6dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_plan_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp">
        <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D6EDE1" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="5dp" android:progressDrawable="@drawable/widget_plan_progress" android:indeterminate="false" android:max="100" android:progress="0" />
    </LinearLayout>
</LinearLayout>
