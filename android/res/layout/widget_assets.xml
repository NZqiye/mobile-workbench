<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_asset_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_icon" android:layout_width="52dp" android:layout_height="64dp" android:scaleType="fitCenter" android:contentDescription="物品图标" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="资产记录" android:textColor="#F3F7FF" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="选择要展示的物品" android:textColor="#CFDFF1" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:src="@drawable/widget_settings_light" android:contentDescription="选择展示物品" />
    </LinearLayout>
    <TextView android:id="@+id/widget_days" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="32dp" android:gravity="center_vertical" android:text="打开 App 同步资产" android:textColor="#F3F7FF" android:textSize="15sp" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:id="@+id/widget_cost_row" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/widget_asset_inset">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="日均成本" android:textColor="#F3F7FF" android:textSize="15sp" android:maxLines="1" />
        <TextView android:id="@+id/widget_daily" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:gravity="end" android:text="—" android:textColor="#D4C9FF" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#D4C9FF" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="总金额" android:textColor="#CFDFF1" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_drop_column" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/widget_drop" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="—" android:textColor="#D4C9FF" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="end" android:text="日均下降" android:textColor="#CFDFF1" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
